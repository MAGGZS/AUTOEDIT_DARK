# FLAXY — backend. Copie para .env (local) ou configure no painel do Render.

# local | production
FLAXY_ENV=local

# Origens que podem chamar a API, separadas por vírgula.
# Em produção é obrigatório: sem login, o CORS é a única separação entre o seu
# frontend e qualquer outro site.
# CORS_ORIGINS=https://flaxy.vercel.app

# Previews da Vercel mudam de subdomínio a cada deploy.
# CORS_ORIGIN_REGEX=^https://flaxy-.*\.vercel\.app$

# Banco. Sem isto, SQLite local. No Render, use a Internal Database URL
# do PostgreSQL — `postgres://` é convertido automaticamente.
# DATABASE_URL=postgresql://usuario:senha@host:5432/flaxy

# Onde ficam os arquivos de fundo dos templates. Precisa ser um disco
# persistente em produção, ou eles somem a cada deploy.
# FLAXY_STORAGE_DIR=/data/storage

# Área descartável de uploads e saídas.
# FLAXY_WORK_DIR=/tmp/flaxy

# Segredo compartilhado exigido no cabeçalho X-Flaxy-Key.
# Interino, até existir login: impede que uma URL descoberta por acaso vire
# renderização de vídeo por conta da casa.
# FLAXY_API_KEY=troque-por-um-valor-longo-e-aleatorio

# Renders simultâneos. 1 é o certo na maioria dos casos: dois FFmpeg disputando
# a mesma CPU terminam mais devagar que em fila.
FLAXY_MAX_CONCURRENT=1

FLAXY_MAX_VIDEOS_PER_JOB=100

# Limite por arquivo enviado, em MB. 0 = sem limite.
# Numa instância de 512 MB, deixe um teto: um upload gigante derruba o processo.
FLAXY_MAX_UPLOAD_MB=0
